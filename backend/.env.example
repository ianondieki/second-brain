# ==============================================================================
#  Backend settings (bridge/config.py). Copy to backend/.env for local runs:
#    copy backend\.env.example backend\.env      (Windows)   cp backend/.env.example backend/.env
#  backend/.env is gitignored. Sandbox/test values only; production values live in SSM (Phase 8).
#  The app refuses to start when a required secret is missing or shorter than 32 characters.
# ==============================================================================

# dev | test | staging | production. Set it explicitly: the provisional directory seed (python -m bridge.seed) loads
# only when APP_ENV is set to dev or test here or in the environment, never from the settings default.
APP_ENV=dev
PRODUCT_NAME=Bridge (working name)
# Where the web app is served; used in magic links and emails.
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
# Proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs). Compose: 127.0.0.1,172.16.0.0/12.
TRUSTED_PROXIES=127.0.0.1

# Config files (defaults: backend/config/plans.yaml and backend/config/consents.yaml).
# PLANS_FILE=
# CONSENTS_FILE=

# --- PostgreSQL (infra/docker-compose.dev.yml) ---------------------------------
# API and worker: the RLS-bound app role. Use host "postgres" inside compose, "localhost" from the host.
DATABASE_URL=postgresql+psycopg://bridge_app:CHANGE_ME_APP_PASSWORD@localhost:5432/bridge
# Migrations and seed only: the owner role.
DATABASE_OWNER_URL=postgresql+psycopg://bridge_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/bridge
# Integration tests (optional): a superuser URL; tests create and drop their own databases.
# Without it the tests start a throwaway pgvector container through testcontainers.
TEST_DATABASE_ADMIN_URL=

# --- Secrets (REQUIRED, >= 32 characters each) -----------------------------------
# PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
# bash:       openssl rand -base64 32
SECRET_KEY=
# Base64 of exactly 32 random bytes (AES-256-GCM key for TOTP secrets at rest).
DATA_ENCRYPTION_KEY=
# HMAC key for TOTP recovery codes (>= 32 characters). Never rotate it: stored codes cannot be re-keyed.
RECOVERY_CODE_PEPPER=

# --- Sessions and auth ---------------------------------------------------------
# Keep true; browsers accept Secure cookies on http://localhost. Cookie names are fixed: __Host-bridge_session,
# __Host-bridge_csrf and __Host-bridge_signup (bare names without the prefix when false; the web app reads both).
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
STEP_UP_MAX_AGE_HOURS=12
LOGIN_ATTEMPTS_PER_MINUTE=5

# --- OAuth sign-in (REQ-AUTH-02; test apps only, D-26) -----------------------------
# A provider is enabled only when both its values are set; leave both empty to hide its button (fail closed).
# Setting only one of a pair stops the app at start-up. Never commit real values; production values live in SSM.
# Redirect (callback) URIs to register with the provider, exactly: {PUBLIC_BASE_URL}/api/auth/oauth/<provider>/callback
#   GitHub OAuth App: http://localhost:3000/api/auth/oauth/github/callback   (scopes: read:user user:email)
#   Google OAuth client (Web application): http://localhost:3000/api/auth/oauth/google/callback
#     (authorised JavaScript origin http://localhost:3000; scopes: openid email profile)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (ADR-004) -----------------------------------------------------------
# smtp (Mailpit in dev, CI and staging) | postmark (production only, ADR-004) | fake (unit tests)
# Fails closed: postmark is refused unless APP_ENV=production; fake is refused when APP_ENV is staging or production.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Bridge <no-reply@bridge.localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
# Required when EMAIL_PROVIDER=postmark. Never commit a real token.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# --- SMS (REQ-PROV-04: D1 phone verification codes) ------------------------------
# fake (dev, test and CI: codes stay in memory, nothing is sent) | africastalking (vendor account at gate G1)
# Fails closed: fake is refused when APP_ENV=production; africastalking is refused when APP_ENV=test and needs
# AFRICASTALKING_USERNAME and AFRICASTALKING_API_KEY. Production refuses the "sandbox" username (simulator only).
SMS_PROVIDER=fake
# The Africa's Talking app username ("sandbox" talks to the sandbox API and never reaches a real phone).
AFRICASTALKING_USERNAME=
# The app's API key (sent in the apiKey header). Never commit a real key.
AFRICASTALKING_API_KEY=
# Optional approved alphanumeric sender id; empty uses the account's default shortcode.
AFRICASTALKING_SENDER_ID=

# --- Feature flags (docs/spec/10: false until the legal gate G2) -----------------
FEATURE_TIER2_ENABLED=false
FEATURE_DEALS_ENABLED=false

# --- Runtime LLMs (ADR-005; bridge/llm) ----------------------------------------------
# Leave empty in dev and test: the app starts, and every LLM call fails closed at call time (LLMUnavailable).
# Production refuses to start without it unless LLM_KILL_SWITCH=1.
# D-18: no paid API calls; tests and make check use fakes and synthetic cassettes only. Never commit a real key.
ANTHROPIC_API_KEY=
# 1 refuses every LLM call with a typed error (LLMKillSwitch) before anything is sent.
LLM_KILL_SWITCH=0
# Spend cap across all tenants per UTC day, in USD. 0 (the default) refuses every call that costs anything.
# Per-tenant monthly caps come from plans.yaml (llm_monthly_cap_usd).
LLM_GLOBAL_DAILY_CAP_USD=1.00
# Task -> model registry and the verified Anthropic price table (default backend/ai/models.yaml).
# LLM_MODELS_FILE=

# --- LLM providers for local prototype runs (D-37; bridge/llm/routing.py) ---------------
# fake | free | anthropic. Empty: free when a complete LLM_FREE_<N> slot below is set, else fake. Anthropic runs only
# with LLM_PROVIDER=anthropic (and ANTHROPIC_API_KEY, the caps above and below, and verified prices in models.yaml).
# Staging and production run Anthropic only: they refuse LLM_PROVIDER=free and any LLM_FREE_* value.
# In dev a missing key, a hit cap, LLM_KILL_SWITCH=1 or a failed call answers with the deterministic fake, labelled
# "demo fallback". Tests and make check always run on the fake (the test conftest sets LLM_PROVIDER=fake).
LLM_PROVIDER=
# Lifetime spend cap of this database's llm_calls ledger in USD (only Anthropic costs money): the USD 5 prototype
# total. 0 refuses every call that costs anything. Resetting the demo database resets the count.
LLM_PROTOTYPE_TOTAL_CAP_USD=5.00
# Free OpenAI-compatible provider slots (1 to 3), tried in the order models.yaml lists them per task (free_slots).
# ONLY SEEDED DEMO DATA goes to a free provider (users.demo_account; the provider may train on it): any other user's
# call answers with the fake, and another user's Tier-2 text is refused before anything is sent.
# Per slot, set all four or none (half a slot stops start-up):
#   BASE_URL        the API base (https; plain http only on localhost), e.g. .../v1; /chat/completions is appended
#   API_KEY         the provider key (never commit it; a local model server accepts any non-empty value)
#   MODEL           the provider's model id (1-74 characters)
#   DAILY_REQUESTS  requests per UTC day through this slot, counted in the llm_calls ledger (the provider's free quota)
#   RESPONSE_FORMAT optional: json_object (default) | json_schema | none (the schema is always in the prompt too)
LLM_FREE_1_BASE_URL=
LLM_FREE_1_API_KEY=
LLM_FREE_1_MODEL=
LLM_FREE_1_DAILY_REQUESTS=
LLM_FREE_1_RESPONSE_FORMAT=
LLM_FREE_2_BASE_URL=
LLM_FREE_2_API_KEY=
LLM_FREE_2_MODEL=
LLM_FREE_2_DAILY_REQUESTS=
LLM_FREE_2_RESPONSE_FORMAT=
LLM_FREE_3_BASE_URL=
LLM_FREE_3_API_KEY=
LLM_FREE_3_MODEL=
LLM_FREE_3_DAILY_REQUESTS=
LLM_FREE_3_RESPONSE_FORMAT=

# --- Embeddings (ADR-005 decision 6) -------------------------------------------------
# fake (dev, test, CI: deterministic 1024-dim vectors) | bge-m3 (the worker). Production refuses fake.
# bge-m3 needs sentence-transformers and local weights, neither in the repo: the worker image installs them (CPU-only
# torch index) only after the human approves bge-m3 (Docker has 4 GB). Code never downloads weights.
EMBEDDER=fake
# Local directory holding the BAAI/bge-m3 weights (default: the Hugging Face cache, offline only).
# EMBEDDER_MODEL_PATH=

# --- Tier-2 envelope encryption (bridge/crypto/envelope.py, ADR-007) --------------
# Each proposal's AES-256-GCM data key is wrapped by a key encryption key. Set exactly one of the two.
# Dev/test: base64 of 32 random bytes (bash: openssl rand -base64 32). Refused when APP_ENV=production.
TIER2_LOCAL_KEK=
# Production: the KMS key that wraps data keys (KMS wrapping arrives with Phase 8; until then Tier 2 fails closed).
TIER2_KMS_KEY_ID=

# --- Provenance (bridge/provenance/, ADR-003) ------------------------------------
# Ed25519 signing key for registration manifests and transparency roots; the worker needs it, the API does not.
# Dev/test: base64 of the 32-byte raw private key (bash: openssl rand -base64 32). Refused when APP_ENV=production.
# Register its public key once per database: uv run python -m bridge.provenance register-key (owner role).
PROVENANCE_SIGNING_KEY=
# Production: the KMS signing key (Phase 8). Set exactly one of PROVENANCE_SIGNING_KEY and PROVENANCE_KMS_KEY_ID.
PROVENANCE_KMS_KEY_ID=
# RFC 3161 timestamp authorities: DigiCert primary, FreeTSA fallback (leave the fallback empty to disable it).
# Tests never contact either: they run a local openssl test TSA.
TSA_URL=http://timestamp.digicert.com
TSA_FALLBACK_URL=https://freetsa.org/tsr
TSA_TIMEOUT_SECONDS=10
# Seconds for one whole timestamp attempt, primary and fallback together (each request also has the timeout above).
TSA_DEADLINE_SECONDS=30
# The pinned CA bundle (a PEM file path) of each TSA: a token must chain to it. Required outside APP_ENV dev/test (the
# TSA client fails closed at use without it); in dev/test an empty value skips only the chain check (logged).
TSA_CA_BUNDLE=
TSA_FALLBACK_CA_BUNDLE=
# The nightly audit.verify_chain job reads every audit chain as audit_reader (a separate login; the job fails
# closed without it). Compose dev leaves it empty: the job then reports that it cannot run.
AUDIT_READER_DATABASE_URL=

# --- Object storage (bridge/storage/objects.py, ADR-007, D-24) --------------------
# s3 (AWS S3, or SeaweedFS in dev) | memory (tests only; refused in staging and production)
OBJECT_STORE=s3
# SeaweedFS from infra/docker-compose.dev.yml (host: http://localhost:8333, compose: http://s3:8333). Empty = AWS.
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=af-south-1
# Dev SeaweedFS accepts any credentials; production leaves both empty and uses the instance role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_KYC_REVIEW=kyc-review
S3_BUCKET_UPLOADS=uploads

# --- Attachment scanning (bridge/storage/scanner.py, D-36) --------------------------
# fake (dev and test only: the EICAR test string is "infected", everything else "clean"; the prototype's scanner)
# | clamav (returns after the prototype; refused until then). Uploads answer 503 when the scanner is refused.
ATTACHMENT_SCANNER=fake
