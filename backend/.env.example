# ==============================================================================
#  Backend settings (bridge/config.py). Copy to backend/.env for local runs:
#    copy backend\.env.example backend\.env      (Windows)   cp backend/.env.example backend/.env
#  backend/.env is gitignored. Sandbox/test values only; production values live in SSM (Phase 8).
#  The app refuses to start when a required secret is missing or shorter than 32 characters.
# ==============================================================================

# dev | test | staging | production
APP_ENV=dev
PRODUCT_NAME=Bridge (working name)
# Where the web app is served; used in magic links and emails.
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
# Proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs). Compose: 127.0.0.1,172.16.0.0/12.
TRUSTED_PROXIES=127.0.0.1

# Config files (defaults: backend/config/plans.yaml and backend/config/consents.yaml).
# PLANS_FILE=
# CONSENTS_FILE=

# --- PostgreSQL (infra/docker-compose.dev.yml) ---------------------------------
# API and worker: the RLS-bound app role. Use host "postgres" inside compose, "localhost" from the host.
DATABASE_URL=postgresql+psycopg://bridge_app:CHANGE_ME_APP_PASSWORD@localhost:5432/bridge
# Migrations and seed only: the owner role.
DATABASE_OWNER_URL=postgresql+psycopg://bridge_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/bridge
# Integration tests (optional): a superuser URL; tests create and drop their own databases.
# Without it the tests start a throwaway pgvector container through testcontainers.
TEST_DATABASE_ADMIN_URL=

# --- Secrets (REQUIRED, >= 32 characters each) -----------------------------------
# PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
# bash:       openssl rand -base64 32
SECRET_KEY=
# Base64 of exactly 32 random bytes (AES-256-GCM key for TOTP secrets at rest).
DATA_ENCRYPTION_KEY=
# HMAC key for TOTP recovery codes (>= 32 characters). Never rotate it: stored codes cannot be re-keyed.
RECOVERY_CODE_PEPPER=

# --- Sessions and auth ---------------------------------------------------------
# Keep true; browsers accept Secure cookies on http://localhost. Cookie names are fixed: __Host-bridge_session,
# __Host-bridge_csrf and __Host-bridge_signup (bare names without the prefix when false; the web app reads both).
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
STEP_UP_MAX_AGE_HOURS=12
LOGIN_ATTEMPTS_PER_MINUTE=5

# --- Email (ADR-004) -----------------------------------------------------------
# smtp (Mailpit in dev, CI and staging) | postmark (production only, ADR-004) | fake (unit tests)
# Fails closed: postmark is refused unless APP_ENV=production; fake is refused when APP_ENV is staging or production.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Bridge <no-reply@bridge.localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
# Required when EMAIL_PROVIDER=postmark. Never commit a real token.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# --- Feature flags (docs/spec/10: false until the legal gate G2) -----------------
FEATURE_TIER2_ENABLED=false
FEATURE_DEALS_ENABLED=false

# --- Runtime LLMs (ADR-005; bridge/llm) ----------------------------------------------
# Leave empty in dev and test: the app starts, and every LLM call fails closed at call time (LLMUnavailable).
# Production refuses to start without it unless LLM_KILL_SWITCH=1.
# D-18: no paid API calls; tests and make check use fakes and synthetic cassettes only. Never commit a real key.
ANTHROPIC_API_KEY=
# 1 refuses every LLM call with a typed error (LLMKillSwitch) before anything is sent.
LLM_KILL_SWITCH=0
# Spend cap across all tenants per UTC day, in USD. 0 (the default) refuses every call that costs anything.
# Per-tenant monthly caps come from plans.yaml (llm_monthly_cap_usd).
LLM_GLOBAL_DAILY_CAP_USD=1.00
# Task -> model registry and placeholder price table (default backend/ai/models.yaml).
# LLM_MODELS_FILE=

# --- Embeddings (ADR-005 decision 6) -------------------------------------------------
# fake (dev, test, CI: deterministic 1024-dim vectors) | bge-m3 (the worker). Production refuses fake.
# bge-m3 needs sentence-transformers and local weights, neither in the repo: the worker image installs them (CPU-only
# torch index) only after the human approves bge-m3 (Docker has 4 GB). Code never downloads weights.
EMBEDDER=fake
# Local directory holding the BAAI/bge-m3 weights (default: the Hugging Face cache, offline only).
# EMBEDDER_MODEL_PATH=
