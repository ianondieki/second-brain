# ==============================================================================
#  Backend settings (bridge/config.py). Copy to backend/.env for local runs:
#    copy backend\.env.example backend\.env      (Windows)   cp backend/.env.example backend/.env
#  backend/.env is gitignored. Sandbox/test values only; production values live in SSM (Phase 8).
#  The app refuses to start when a required secret is missing or shorter than 32 characters.
# ==============================================================================

# dev | test | staging | production
APP_ENV=dev
PRODUCT_NAME=Bridge (working name)
# Where the web app is served; used in magic links and emails.
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=INFO
# Proxies whose X-Forwarded-For is trusted (comma-separated IPs/CIDRs). Compose: 127.0.0.1,172.16.0.0/12.
TRUSTED_PROXIES=127.0.0.1

# Config files (defaults: backend/config/plans.yaml and backend/config/consents.yaml).
# PLANS_FILE=
# CONSENTS_FILE=

# --- PostgreSQL (infra/docker-compose.dev.yml) ---------------------------------
# API and worker: the RLS-bound app role. Use host "postgres" inside compose, "localhost" from the host.
DATABASE_URL=postgresql+psycopg://bridge_app:CHANGE_ME_APP_PASSWORD@localhost:5432/bridge
# Migrations and seed only: the owner role.
DATABASE_OWNER_URL=postgresql+psycopg://bridge_owner:CHANGE_ME_OWNER_PASSWORD@localhost:5432/bridge
# Integration tests (optional): a superuser URL; tests create and drop their own databases.
# Without it the tests start a throwaway pgvector container through testcontainers.
TEST_DATABASE_ADMIN_URL=

# --- Secrets (REQUIRED, >= 32 characters each) -----------------------------------
# PowerShell: [Convert]::ToBase64String((1..32 | % { Get-Random -Maximum 256 }))
# bash:       openssl rand -base64 32
SECRET_KEY=
# Base64 of exactly 32 random bytes (AES-256-GCM key for TOTP secrets at rest).
DATA_ENCRYPTION_KEY=
# HMAC key for TOTP recovery codes (>= 32 characters). Never rotate it: stored codes cannot be re-keyed.
RECOVERY_CODE_PEPPER=

# --- Sessions and auth ---------------------------------------------------------
# Keep true; browsers accept Secure cookies on http://localhost. Cookie names are fixed: __Host-bridge_session,
# __Host-bridge_csrf and __Host-bridge_signup (bare names without the prefix when false; the web app reads both).
COOKIE_SECURE=true
SESSION_TTL_DAYS=30
MAGIC_LINK_TTL_MINUTES=15
STEP_UP_MAX_AGE_HOURS=12
LOGIN_ATTEMPTS_PER_MINUTE=5

# --- Email (ADR-004) -----------------------------------------------------------
# smtp (Mailpit in dev, CI and staging) | postmark (production only, ADR-004) | fake (unit tests)
# Fails closed: postmark is refused unless APP_ENV=production; fake is refused when APP_ENV is staging or production.
EMAIL_PROVIDER=smtp
EMAIL_FROM=Bridge <no-reply@bridge.localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
# Required when EMAIL_PROVIDER=postmark. Never commit a real token.
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound

# --- Feature flags (docs/spec/10: false until the legal gate G2) -----------------
FEATURE_TIER2_ENABLED=false
FEATURE_DEALS_ENABLED=false

# --- Tier-2 envelope encryption (bridge/crypto/envelope.py, ADR-007) --------------
# Each proposal's AES-256-GCM data key is wrapped by a key encryption key. Set exactly one of the two.
# Dev/test: base64 of 32 random bytes (bash: openssl rand -base64 32). Refused when APP_ENV=production.
TIER2_LOCAL_KEK=
# Production: the KMS key that wraps data keys (KMS wrapping arrives with Phase 8; until then Tier 2 fails closed).
TIER2_KMS_KEY_ID=

# --- Provenance (bridge/provenance/, ADR-003) ------------------------------------
# Ed25519 signing key for registration manifests and transparency roots; the worker needs it, the API does not.
# Dev/test: base64 of the 32-byte raw private key (bash: openssl rand -base64 32). Refused when APP_ENV=production.
# Register its public key once per database: uv run python -m bridge.provenance register-key (owner role).
PROVENANCE_SIGNING_KEY=
# Production: the KMS signing key (Phase 8). Set exactly one of PROVENANCE_SIGNING_KEY and PROVENANCE_KMS_KEY_ID.
PROVENANCE_KMS_KEY_ID=
# RFC 3161 timestamp authorities: DigiCert primary, FreeTSA fallback (leave the fallback empty to disable it).
# Tests never contact either: they run a local openssl test TSA.
TSA_URL=http://timestamp.digicert.com
TSA_FALLBACK_URL=https://freetsa.org/tsr
TSA_TIMEOUT_SECONDS=10
# The nightly audit.verify_chain job reads every audit chain as audit_reader (a separate login; the job fails
# closed without it). Compose dev leaves it empty: the job then reports that it cannot run.
AUDIT_READER_DATABASE_URL=

# --- Object storage (bridge/storage/objects.py, ADR-007, D-24) --------------------
# s3 (AWS S3, or SeaweedFS in dev) | memory (tests only; refused in staging and production)
OBJECT_STORE=s3
# SeaweedFS from infra/docker-compose.dev.yml (host: http://localhost:8333, compose: http://s3:8333). Empty = AWS.
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=af-south-1
# Dev SeaweedFS accepts any credentials; production leaves both empty and uses the instance role.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_EVIDENCE=evidence
S3_BUCKET_KYC_REVIEW=kyc-review
S3_BUCKET_UPLOADS=uploads
