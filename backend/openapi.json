        "title": "CsrfResponse",
        "type": "object"
      },
      "DevVerification": {
        "enum": [
          "d0",
          "d1",
          "d2",
          "d3"
        ],
        "title": "DevVerification",
        "type": "string"
      },
      "EmailRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailRequest",
        "type": "object"
      },
      "EntitlementsOut": {
