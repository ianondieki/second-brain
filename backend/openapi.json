            "$ref": "#/components/schemas/DevVerification"
          }
        },
        "required": [
          "handle",
          "verification_level",
          "headline",
          "bio",
          "county_code"
        ],
        "title": "ProfileOut",
        "type": "object"
      },
      "ProfileUpdate": {
        "properties": {
          "bio": {
            "anyOf": [
              {
                "maxLength": 4000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio"
          },
          "county_code": {
            "anyOf": [
              {
                "pattern": "^KE-\\d{2}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "County Code"
          },
          "headline": {
            "anyOf": [
              {
                "maxLength": 160,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Headline"
          }
        },
        "title": "ProfileUpdate",
        "type": "object"
      },
      "RecoveryCodesResponse": {
        "properties": {
          "recovery_codes": {
