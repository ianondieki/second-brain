{
  "components": {
    "schemas": {
      "AcceptedResponse": {
        "properties": {
          "status": {
            "const": "check_email",
            "default": "check_email",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "AcceptedResponse",
        "type": "object"
      },
      "CodeRequest": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "maxLength": 20,
            "minLength": 6,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "CodeRequest",
        "type": "object"
      },
      "ConsentItem": {
        "properties": {
