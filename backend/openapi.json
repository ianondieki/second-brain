            "type": "string"
          }
        },
        "required": [
          "user_id",
          "display_name",
          "roles"
        ],
        "title": "MemberOut",
        "type": "object"
      },
      "MembershipOut": {
        "properties": {
          "org_id": {
            "format": "uuid",
            "title": "Org Id",
            "type": "string"
          },
          "org_name": {
            "title": "Org Name",
            "type": "string"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/OrgRole"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "org_id",
          "org_name",
          "roles"
        ],
        "title": "MembershipOut",
        "type": "object"
      },
      "MfaState": {
        "properties": {
          "enrolled": {
            "title": "Enrolled",
            "type": "boolean"
          },
          "required": {
            "title": "Required",
            "type": "boolean"
          },
          "verified": {
            "title": "Verified",
            "type": "boolean"
          }
        },
        "required": [
          "required",
          "enrolled",
          "verified"
        ],
        "title": "MfaState",
        "type": "object"
      },
      "MyOrgOut": {
        "properties": {
          "org": {
            "$ref": "#/components/schemas/OrgOut"
          },
          "roles": {
            "items": {
              "$ref": "#/components/schemas/OrgRole"
            },
            "title": "Roles",
            "type": "array"
          }
        },
        "required": [
          "org",
          "roles"
        ],
        "title": "MyOrgOut",
        "type": "object"
      },
      "OrgKind": {
        "description": "Axis 1, Org Type (docs/spec/03).",
        "enum": [
          "company",
          "sme",
          "sacco_mfi",
          "university_tvet",
          "school",
          "national_govt",
          "county_govt",
          "ngo_pbo",
          "development_partner"
        ],
        "title": "OrgKind",
        "type": "string"
      },
      "OrgOut": {
        "properties": {
          "country": {
            "title": "Country",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/OrgKind"
          },
          "legal_name": {
            "title": "Legal Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "verification": {
            "$ref": "#/components/schemas/OrgVerification"
          },
          "website": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          }
        },
        "required": [
          "id",
          "legal_name",
          "slug",
          "kind",
          "country",
          "verification",
          "website"
        ],
        "title": "OrgOut",
        "type": "object"
      },
      "OrgRole": {
        "enum": [
          "owner",
          "admin",
          "reviewer",
          "signatory",
          "finance",
          "viewer"
        ],
        "title": "OrgRole",
        "type": "string"
      },
      "OrgSignup": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/OrgKind"
          },
          "legal_name": {
            "maxLength": 200,
            "minLength": 2,
            "title": "Legal Name",
            "type": "string"
          }
        },
        "required": [
          "legal_name",
          "kind"
        ],
        "title": "OrgSignup",
        "type": "object"
      },
      "OrgUpdate": {
        "properties": {
          "legal_name": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Legal Name"
          },
          "website": {
            "anyOf": [
              {
                "maxLength": 255,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Website"
          }
        },
        "title": "OrgUpdate",
        "type": "object"
      },
      "OrgVerification": {
        "enum": [
          "unclaimed",
          "pending",
          "e1",
          "e2",
          "rejected"
        ],
        "title": "OrgVerification",
        "type": "string"
      },
      "PlanSide": {
        "enum": [
          "developer",
          "org"
        ],
        "title": "PlanSide",
        "type": "string"
      },
      "ProfileOut": {
        "properties": {
          "bio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio"
          },
          "county_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "County Code"
          },
          "handle": {
            "title": "Handle",
            "type": "string"
          },
          "headline": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Headline"
          },
