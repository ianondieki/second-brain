        "title": "ConsentItem",
        "type": "object"
      },
      "ConsentPurpose": {
        "description": "Separate purposes (docs/spec/10; REQ-CON-01).",
        "enum": [
          "marketing",
          "reminders",
          "whatsapp",
          "profiling",
          "github_import",
          "tier2_llm_assistant",
          "tier2_llm_moderation"
