          }
        },
        "required": [
          "user",
          "mfa_required"
        ],
        "title": "SessionResponse",
        "type": "object"
      },
      "SignupRequest": {
        "additionalProperties": false,
        "properties": {
          "accept_terms": {
            "title": "Accept Terms",
            "type": "boolean"
          },
          "consents": {
            "additionalProperties": {
              "type": "boolean"
            },
            "propertyNames": {
              "$ref": "#/components/schemas/ConsentPurpose"
            },
            "title": "Consents",
            "type": "object"
          },
          "display_name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "locale": {
            "default": "en",
            "enum": [
              "en",
              "sw"
            ],
            "title": "Locale",
            "type": "string"
          },
          "org": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrgSignup"
              },
              {
                "type": "null"
              }
            ]
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          },
          "side": {
            "enum": [
              "developer",
              "org"
            ],
            "title": "Side",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password",
          "display_name",
          "side",
          "accept_terms"
        ],
        "title": "SignupRequest",
        "type": "object"
      },
      "StaffRole": {
        "enum": [
          "admin",
          "moderator",
          "support"
        ],
        "title": "StaffRole",
        "type": "string"
      },
      "TokenRequest": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 200,
            "minLength": 20,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "TokenRequest",
        "type": "object"
      },
      "TotpEnrolResponse": {
        "properties": {
          "otpauth_uri": {
            "title": "Otpauth Uri",
            "type": "string"
          },
          "secret": {
            "title": "Secret",
            "type": "string"
          }
        },
        "required": [
          "secret",
          "otpauth_uri"
        ],
        "title": "TotpEnrolResponse",
        "type": "object"
      },
      "UserOut": {
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "locale": {
            "title": "Locale",
            "type": "string"
          },
          "staff_role": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/StaffRole"
              },
