{# N17 organisation interest, HTML part (REQUIREMENTS.md §5 N17; docs/spec/06 6.9 stage 0). Autoescaped. One call to
   action; the only links are the platform's. [[COPY-REVIEW]] #}
{% extends "_brand.html.j2" %}
{% import "_macros.html.j2" as ui %}
{% block title %}{{ company_name }}{% endblock %}
{% block body %}
<p style="margin:0 0 16px">{{ company_name }} found your proposal &ldquo;<strong>{{ title }}</strong>&rdquo; {{ found_by }} and would like to talk about taking it further.</p>
<p style="font-size:14px;line-height:1.6;margin:0 0 16px">Accept or decline {{ respond_by }} on your tracker. If you accept, the contact they named can reach you. Their interest is not a contract or a commitment to buy, and your full proposal stays private unless you choose to share it.</p>
<p style="margin:24px 0 0">{{ ui.button(tracker_url, "Open your tracker", "open-tracker") }}</p>
{% endblock %}
{% block footer_line %}{{ product }} · Engagement ref {{ engagement_ref }}{% endblock %}
