{# P28's tracker notices, HTML part (REQ-NOT-05: EM5 Signature needed, EM6 Contact overdue, the escalations, the
   procurement route chosen; bridge.notifications.nudge_copy): the branded frame in the recipient's language, the
   paragraphs, one call to action to their tracker and its address, the engagement's ref in the small print.
   Autoescaped; names and titles arrive unlinkable. [[COPY-REVIEW]] #}
{% extends "_brand.html.j2" %}
{% import "_macros.html.j2" as ui %}
{% block title %}{{ subject }}{% endblock %}
{% block body %}
{% for paragraph in paragraphs %}
<p style="margin:0 0 16px">{{ paragraph }}</p>
{% endfor %}
<p style="margin:24px 0 8px">{{ ui.button(button_url, button_label, "open-tracker") }}</p>
<p style="margin:0;font-size:12px;line-height:1.6;color:#5e5873;word-break:break-all">{{ or_open }}: {{ button_url }}</p>
{% endblock %}
{% block footer_line %}{{ product }} · {{ ref_label }} {{ engagement_ref }}{% endblock %}
