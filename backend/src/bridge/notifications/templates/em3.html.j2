{# EM3 scout digest, HTML part (docs/spec/06 6.8, 6.10; REQ-SCOUT-03). Autoescaped; every value is filled in by code
   and party or model text arrives defanged. Links are platform URLs only; nothing changes state on GET. One call to
   action. [[COPY-REVIEW]] #}
{% extends "_brand.html.j2" %}
{% import "_macros.html.j2" as ui %}
{% block title %}{{ subject }}{% endblock %}
{% block body %}
<p style="margin:0 0 16px">{{ headline }}</p>
<ol style="margin:0;padding-left:20px;font-size:14px;line-height:1.6">
{% for item in items %}
<li style="margin:0 0 16px"><a href="{{ item.url }}" style="color:#5a3fc0;font-weight:600">{{ item.title }}</a><br>
<span style="display:inline-block;background:#efebfc;color:#5a3fc0;border-radius:999px;padding:0 8px;font-size:12px;font-weight:600">{{ item.niche }}</span>
<span style="font-size:12px;color:#5e5873"> Fit {{ item.score }}/100{% if item.details %} · {{ item.details }}{% endif %}</span><br>
<span>Why: {{ item.why }}</span><br>
<span style="font-size:12px;color:#5e5873">{{ item.why_label }}</span></li>
{% endfor %}
</ol>
{% if more %}
<p style="font-size:14px;line-height:1.6;margin:0 0 16px">{{ more }}</p>
{% endif %}
<p style="font-size:13px;line-height:1.6;color:#5e5873;margin:0 0 16px">Teasers are public summaries written by developers. Open a match to read it, give feedback or express interest: nothing changes until you act on the platform.</p>
<p style="margin:24px 0 0">{{ ui.button(matches_url, "Open your scout matches", "open-scout-matches") }}</p>
{% endblock %}
{% block footer_line %}{{ product }} · Scout digest for {{ org_name }}{% endblock %}
