{# EM3 scout digest, HTML part (docs/spec/06 6.8, 6.10; REQ-SCOUT-03). Autoescaped; every value is filled in by code
   and party or model text arrives defanged. Links are platform URLs only; nothing changes state on GET. One call to
   action. [[COPY-REVIEW]] #}
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8"><meta name="format-detection" content="telephone=no,date=no,address=no,email=no"><title>{{ subject }}</title></head>
<body style="margin:0;padding:24px;background:#f4f4f5;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#18181b">
<div style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e4e4e7;border-radius:8px;padding:24px">
<p style="font-size:16px;line-height:1.5;margin:0 0 16px">{{ headline }}</p>
<ol style="margin:0;padding-left:20px;font-size:14px;line-height:1.5">
{% for item in items %}
<li style="margin:0 0 16px"><a href="{{ item.url }}" style="color:#1d4ed8;font-weight:600">{{ item.title }}</a><br>
<span style="display:inline-block;background:#eef2ff;color:#3730a3;border-radius:4px;padding:0 6px;font-size:12px">{{ item.niche }}</span>
<span style="font-size:12px;color:#52525b"> Fit {{ item.score }}/100{% if item.details %} · {{ item.details }}{% endif %}</span><br>
<span>Why: {{ item.why }}</span><br>
<span style="font-size:12px;color:#52525b">{{ item.why_label }}</span></li>
{% endfor %}
</ol>
{% if more %}
<p style="font-size:14px;line-height:1.5;margin:0 0 16px">{{ more }}</p>
{% endif %}
<p style="font-size:13px;line-height:1.5;color:#52525b;margin:0 0 16px">Teasers are public summaries written by developers. Open a match to read it, give feedback or express interest: nothing changes until you act on the platform.</p>
<p style="margin:24px 0"><a data-cta="open-scout-matches" href="{{ matches_url }}" style="display:inline-block;background:#1d4ed8;color:#ffffff;text-decoration:none;padding:10px 16px;border-radius:6px;font-size:14px">Open your scout matches</a></p>
</div>
<p style="max-width:560px;margin:16px auto 0;font-size:12px;line-height:1.5;color:#71717a;text-align:center">{{ product }} · Scout digest for {{ org_name }}<br><a href="{{ settings_url }}" style="color:#71717a">Manage notifications</a> · <a href="{{ help_url }}" style="color:#71717a">Help</a> · Nairobi, Kenya</p>
</body>
</html>
