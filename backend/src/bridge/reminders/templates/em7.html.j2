{# EM7 daily progress digest, developer and organisation versions (docs/spec/06 6.10, 6.11). Every value is filled
   in by code and escaped (autoescape); party text arrives quoted and defanged. Links are platform URLs only. #}
{% extends "_brand.html.j2" %}
{% import "_macros.html.j2" as ui %}
{% block title %}{{ email.subject }}{% endblock %}
{% block body %}
<p style="margin:0 0 8px">{{ email.headline }}</p>
{% for note in email.notes %}
<p style="font-size:12px;color:#5e5873;margin:0 0 8px">{{ note }}</p>
{% endfor %}
{% for section in email.sections %}
{{ ui.label(section.title) }}
<ul style="margin:0;padding-left:20px;font-size:14px;line-height:1.6">
{% for line in section.lines %}
<li style="margin:0 0 6px">{{ line }}</li>
{% endfor %}
</ul>
{% endfor %}
{% if email.next_step %}
{{ ui.label("Next step") }}
<p style="font-size:14px;line-height:1.6;margin:0">{{ email.next_step }}</p>
{% endif %}
<p style="margin:24px 0 0">{{ ui.button(cta_url, email.cta_label, "open") }}</p>
{% endblock %}
{% block footer_line %}{{ email.footer }}{% endblock %}
