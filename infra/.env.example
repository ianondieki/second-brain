# Dev compose values (infra/docker-compose.dev.yml). Copy to infra/.env (gitignored) and pick your own values.
# These are local-only passwords for the dev database container, never used anywhere else.
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_SUPERUSER_PASSWORD
BRIDGE_OWNER_PASSWORD=CHANGE_ME_OWNER_PASSWORD
BRIDGE_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
# Passed to the web container; must equal COOKIE_SECURE in backend/.env (see frontend/.env.example). Default true.
COOKIE_SECURE=true
