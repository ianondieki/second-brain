{"nodes": [{"id": "docs_09_telegram_two_way", "label": "Section 9 - Two-Way Telegram Assistant", "file_type": "document", "source_file": "docs/09-telegram-two-way.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_09_telegram_two_way_telegram_assistant", "label": "Telegram Assistant Workflow", "file_type": "concept", "source_file": "docs/09-telegram-two-way.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_09_telegram_two_way_getupdates_long_poll", "label": "getUpdates Long Polling (timeout < interval)", "file_type": "concept", "source_file": "docs/09-telegram-two-way.md", "source_location": "L8", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "n8n is loopback-only with no public URL, so polling avoids a tunnel; poll hold (4s) < cadence (5s) prevents overlapping consumers and HTTP 409."}, {"id": "docs_09_telegram_two_way_offset_file", "label": "Offset File (.tg_offset)", "file_type": "concept", "source_file": "docs/09-telegram-two-way.md", "source_location": "L28", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "File not n8n static data, because static data is not persisted on manual runs; advanced early, before the slow LLM call, so nothing is handled twice."}, {"id": "docs_09_telegram_two_way_owner_only_guard", "label": "Owner-only / No-self-loop Guards", "file_type": "concept", "source_file": "docs/09-telegram-two-way.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_09_telegram_two_way_grounded_followups", "label": "Grounded Follow-ups (.tg_context.json focus)", "file_type": "concept", "source_file": "docs/09-telegram-two-way.md", "source_location": "L83", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_09_telegram_two_w