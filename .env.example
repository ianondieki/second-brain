# ==============================================================================
#  Template for the local companion's .env: the project reminders (reminder/) and
#  the WhatsApp voice adviser (adviser/). Both read ".env" from the repo root.
#  Copy it and fill the values you need; the real .env is gitignored — never commit it.
#    Windows:   copy .env.example .env
#    WSL/bash:  cp .env.example .env
#  Details: docs/10-project-reminders.md ("Secrets: .env") and
#           docs/11-whatsapp-voice-adviser.md.
#  The hosted platform has its own templates: backend/.env.example, frontend/.env.example.
# ==============================================================================

# --- Timezone -----------------------------------------------------------------
# The reminders run on the laptop clock (Windows Task Scheduler); this value
# documents the intended zone and is what containers and scripts should use.
TZ=Africa/Nairobi

# --- Email reminders (Gmail SMTP) ---------------------------------------------
# Gmail account + App Password (needs 2-Step Verification):
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# Where the email goes (defaults to GMAIL_ADDRESS).
REMINDER_EMAIL_TO=

# --- Agent model (Groq, free tier) ----------------------------------------------
# https://console.groq.com/keys — without a key the investigator agent is skipped.
GROQ_API_KEY=
# If Groq retires a model, change it here (no code change needed).
GROQ_MODEL=openai/gpt-oss-20b

# --- WhatsApp reminders (Meta WhatsApp Cloud API) --------------------------------
# Meta System User token and the ids from WhatsApp -> API Setup.
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
# Your number in E.164 without the leading '+', e.g. 2547XXXXXXXX.
WA_TARGET_NUMBER=
# Template(s) to send, best first, and their language.
WA_TEMPLATE_NAME=project_checkin_v2,project_checkin
WA_TEMPLATE_LANG=en
# Optional: Graph API version (defaults to v26.0).
WA_GRAPH_VERSION=

# --- WhatsApp voice adviser (adviser/, docs/11) ----------------------------------
# Reuses WA_ACCESS_TOKEN / WA_PHONE_NUMBER_ID / WA_BUSINESS_ACCOUNT_ID /
# WA_TARGET_NUMBER / GROQ_API_KEY from above, plus:
# REQUIRED. Meta App Dashboard > App settings > Basic > App secret > Show.
# Every webhook is checked against it; without it the adviser will not start.
WA_APP_SECRET=
# Optional: read from WA_ACCESS_TOKEN when empty.
WA_APP_ID=
# Optional: any random string; a random one is kept in .state/adviser when empty.
WA_VERIFY_TOKEN=
# Optional: mirror (voice note -> voice note, text -> text), voice, or text.
ADVISER_REPLY_MODE=mirror
# Optional: an edge-tts voice. Kenyan English: en-KE-ChilembaNeural, en-KE-AsiliaNeural.
ADVISER_VOICE=en-US-AndrewMultilingualNeural
ADVISER_VOICE_SW=sw-KE-ZuriNeural
ADVISER_VOICE_RATE=+0%
# Optional: Groq models to rotate through, best first (each has its own free per-minute budget).
ADVISER_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Optional: set to off to stop the daily voice briefing.
ADVISER_DAILY_VOICE=on
# Optional: path to cloudflared.exe when it is not in tools/ or on PATH.
ADVISER_CLOUDFLARED=
