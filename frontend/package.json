    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
