# Frontend settings. Copy to frontend/.env.local for `npm run dev` (gitignored). No secrets belong here:
# the browser never talks to a provider directly, only to /api on the same origin.

# Where the Next.js server reaches FastAPI (compose: http://api:8000; host: http://127.0.0.1:8000).
API_ORIGIN=http://127.0.0.1:8000
# Base URL the Playwright tests open (the web app) and the Mailpit API they read magic links from.
E2E_BASE_URL=http://localhost:3000
E2E_MAILPIT_URL=http://localhost:8025
