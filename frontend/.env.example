# Frontend settings. Copy to frontend/.env.local for `npm run dev` (gitignored). No secrets belong here:
# the browser never talks to a provider directly, only to /api on the same origin.

# The site's public origin (scheme and host, no path), printed on the authorship certificate and encoded in its QR
# as the verify address. Unset: the certificate shows the path alone (/verify/<id>), never the server's own host.
NEXT_PUBLIC_SITE_ORIGIN=

# Where the Next.js server reaches FastAPI (compose: http://api:8000; host: http://127.0.0.1:8000).
API_ORIGIN=http://127.0.0.1:8000
# Must equal the API's COOKIE_SECURE (backend/.env). true: the server reads only __Host-bridge_session; false (plain
# http, not localhost): only bridge_session. There is no fallback between the two names. Default true.
COOKIE_SECURE=true
# Base URL the Playwright tests open (the web app) and the Mailpit API they read magic links from.
E2E_BASE_URL=http://localhost:3000
E2E_MAILPIT_URL=http://localhost:8025
# The stack's database as bridge_owner (libpq URL), used by the E2E helpers for what no API offers: e2e/support/
# verification.ts raises a test developer (@example.com) to D1 (the fake SMS provider keeps its codes inside the API
# process); e2e/support/research-scene.ts makes a test staff admin and writes a drafted research card (the fake LLM
# drafts none). Required by the Playwright tests that publish and by e2e/research.spec.ts (they fail without it).
# Local test stack only; never a shared or production database.
# With make demo running, `python infra/demo/demo.py e2e-env` prints this and E2E_VERIFY_CERT_ID; CI sets both.
E2E_DATABASE_OWNER_URL=
# A certificate id registered on the stack (the demo seed's), for the /verify record test (required).
E2E_VERIFY_CERT_ID=
# JS budget check (`npm run budget`, `make budget`; docs/runbooks/dev-setup.md), read from the shell, not by Next.js:
# the production web app to measure (http or https), and a Cookie header so signed-in routes are measured, such as
# __Host-bridge_session=<token> (bridge_session=<token> with COOKIE_SECURE=false) of a local test account only.
BUDGET_BASE_URL=http://localhost:3000
BUDGET_COOKIE=
